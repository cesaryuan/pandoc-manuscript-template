oft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex wp14"><w:body><w:p w14:paraId="3C49DE08" w14:textId="77777777" w:rsidR="00235C79" w:rsidRDefault="00235C79"><w:pPr><w:spacing w:before="240" w:after="120"/><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="0000FF"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="0000FF"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t xml:space="preserve">MathType’s Commands for Microsoft Word </w:t></w:r></w:p><w:p w14:paraId="78D7AE79" w14:textId="77777777" w:rsidR="00235C79" w:rsidRDefault="00235C79"><w:r><w:t>© Copyright 2013 by Design Science, Inc. All Rights Reserved.</w:t></w:r></w:p><w:p w14:paraId="054D426F" w14:textId="77777777" w:rsidR="00235C79" w:rsidRDefault="00235C79"><w:pPr><w:spacing w:before="240"/></w:pPr><w:r><w:t>This document contains a set of commands for Microsoft Word that makes working with equations easier. This document should have been installed automatically by MathType Setup, which copies this document to your Word Startup folder so that these commands are available every time Word starts. A copy is also installed into the Office Support folder inside the MathType folder.</w:t></w:r></w:p><w:p w14:paraId="7FFA5424" w14:textId="77777777" w:rsidR="00235C79" w:rsidRDefault="00235C79"><w:pPr><w:spacing w:before="240"/></w:pPr><w:r><w:t>If you installed Microsoft Word after installing MathType, we recommend running MathType Setup again, which will install this document into the correct location. You will not lose any MathType settings by doing this. Alternatively, you can copy the file manually to the Word Startup folder. To find the correct location for the Word Startup folder, choose Options on Word’s Tools menu and select the File Locations tab.</w:t></w:r></w:p><w:p w14:paraId="417AF5A5" w14:textId="77777777" w:rsidR="00235C79" w:rsidRDefault="00235C79"><w:pPr><w:spacing w:before="240"/></w:pPr><w:r><w:t>If MathType Setup has problems installing this document to the Startup folder, it might be because the Startup folder is marked read-only. Please contact your system administrator if this is the case.</w:t></w:r></w:p><w:p w14:paraId="252E8B7E" w14:textId="77777777" w:rsidR="00235C79" w:rsidRDefault="00235C79"><w:pPr><w:tabs><w:tab w:val="left" w:pos="360"/><w:tab w:val="left" w:pos="720"/><w:tab w:val="left" w:pos="9000"/></w:tabs><w:spacing w:before="240"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="008000"/></w:rPr><w:t>Please see the chapter "MathType with Office” in MathType Help for a description of these commands</w:t></w:r></w:p><w:p w14:paraId="05AA1E5E" w14:textId="77777777" w:rsidR="00235C79" w:rsidRDefault="00235C79"><w:pPr><w:spacing w:before="720"/><w:rPr><w:sz w:val="12"/><w:szCs w:val="12"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="12"/><w:szCs w:val="12"/></w:rPr><w:t>R0303 Rev 5.2</w:t></w:r></w:p><w:p w14:paraId="6A5BBB76" w14:textId="77777777" w:rsidR="00533E15" w:rsidRPr="00235C79" w:rsidRDefault="00533E15" w:rsidP="00235C79"/><w:sectPr w:rsidR="00533E15" w:rsidRPr="00235C79" w:rsidSect="00D4673A"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1800" w:bottom="1440" w:left="1800" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>