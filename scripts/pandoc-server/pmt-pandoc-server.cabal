cabal-version: 2.4
name: pmt-pandoc-server
version: 0.1.0.0
build-type: Simple
license: GPL-2.0-or-later
synopsis: Pandoc worker for the PMT project HTML server
description: Long-lived Pandoc worker used by Papper's project-bound HTML service.

executable pmt-pandoc-worker
  main-is: Main.hs
  hs-source-dirs: .
  default-language: Haskell2010
  ghc-options: -threaded -rtsopts -with-rtsopts=-A8m
  build-depends:
      base >= 4.12 && < 5
    , pandoc >= 3.11 && < 3.12
    , pandoc-lua-engine >= 0.5.4 && < 0.6
    , aeson >= 2.0 && < 2.4
    , bytestring >= 0.10 && < 0.13
    , directory >= 1.3 && < 1.4
    , filepath >= 1.4 && < 1.6
    , time >= 1.9 && < 1.13
    , text >= 1.2 && < 2.2
